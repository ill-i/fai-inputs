      </description>
      <example>http://rofr.ivoa.net/examples/</example>
    </schema>
    <schema namespace="http://www.ivoa.net/xml/VOTable/v1.1">
      <location>http://www.ivoa.net/xml/VOTable/v1.1</location>
      <description>
        The XML schema for a VOTable document
      </description>
      <example>http://rofr.ivoa.net/examples/</example>
    </schema>


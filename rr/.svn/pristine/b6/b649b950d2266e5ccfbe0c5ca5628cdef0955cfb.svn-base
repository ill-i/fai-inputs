          <content>
            <subject>Astrophotography</subject>
            <subject>Surveys</subject>
            <subject>Galactic plane</subject>
            <subject>Variable star</subject>
            <subject>CCD photometry</subject>
            <description>This service exposes the light curves of stars produced by the Bochum
Galactic Disk Survey; several million light curves are provided in the
SDSS i and r bands. The lightcurves are published per-band and are
also available through obscore.</description>
            <source format="bibcode">2015AN....336..590H</source>
            <referenceURL>http://dc.zah.uni-heidelberg.de/bgds/l/ssa/info</referenceURL>
            <type>Survey</type>
            <contentLevel>Research</contentLevel>
            <relationship>
              <relationshipType>served-by</relationshipType>
              <relatedResource ivo-id="ivo://org.gavo.dc/tap"
              	altIdentifier="doi:10.fake/tapservice"
              	>GAVO Data Center TAP service</relatedResource>
            </relationship>
          </content>
          <rights>
If you use GDS data, please cite
:bibcode:`2015AN....336..590H`.</rights>
          <capability standardID="ivo://ivoa.net/std/SSA" xsi:type="ssap:SimpleSpectralAccess">
            <interface role="std" xsi:type="vs:ParamHTTP">
              <accessURL use="base">http://dc.zah.uni-heidelberg.de/bgds/l/ssa/ssap.xml?</accessURL>
              <mirrorURL>https://dc.zah.uni-heidelberg.de/bgds/l/ssa/ssap.xml?</mirrorURL>
              <queryType>GET</queryType>
              <resultType>application/x-votable+xml</resultType>
              <param std="true">
                <name>POS</name>
                <description>ICRS position of target object</description>
                <unit>deg</unit>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>SIZE</name>
                <description>Size of the region of interest around POS</description>
                <unit>deg</unit>
                <dataType>real</dataType>
              </param>
              <param std="true">
                <name>BAND</name>
                <description>Wavelength (range) of interest (or symbolic bandpass names)</description>
                <unit>m</unit>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>FORMAT</name>
                <description>MIME type of the file served</description>
                <ucd>meta.code.mime</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>APERTURE</name>
                <description>Angular diameter of aperture</description>
                <unit>deg</unit>
                <ucd>instr.fov</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>SNR</name>
                <description>Signal-to-noise ratio estimated for this dataset</description>
                <ucd>stat.snr</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>REDSHIFT</name>
                <description>Redshift of target object</description>
                <ucd>src.redshift</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>TARGETNAME</name>
                <description>Common name of object observed.</description>
                <ucd>meta.id;src</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>TARGETCLASS</name>
                <description>Object class (star, QSO,...; use Simbad object classification http://simbad.u-strasbg.fr/simbad/sim-display?data=otypes if at all possible)</description>
                <ucd>src.class</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>MTIME</name>
                <description>Date last published.</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>FLUXCALIB</name>
                <description>Type of flux calibration (ABSOLUTE, CALIBRATED, RELATIVE, NORMALIZED, or UNCALIBRATED).</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>SPATRES</name>
                <description>Spatial resolution of data</description>
                <unit>deg</unit>
                <ucd>pos.angResolution</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>WAVECALIB</name>
                <description>Type of wavelength calibration</description>
                <ucd>meta.code.qual</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>COLLECTION</name>
                <description>A short handle naming the collection this spectrum belongs to.</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>SPECRP</name>
                <description>Lower limit to spectral resolution power (&#x3BB;/&#x394;&#x3BB;) as a single number.</description>
                <dataType>real</dataType>
              </param>
              <param std="true">
                <name>PUBDID</name>
                <description>Dataset identifier assigned by the publisher</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>CREATORDID</name>
                <description>Dataset identifier assigned by the creator</description>
                <ucd>meta.id</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="false">
                <name>WILDTARGET</name>
                <description>Shell pattern of target observed (case insensitive)</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="false">
                <name>WILDTARGETCASE</name>
                <description>Shell pattern of target observed (case sensitive)</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>REQUEST</name>
                <description>This is queryData for the default operation; some services support getData as well</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>TOP</name>
                <description>Only return the TOP "best" records (on this service, this usually is equivalent to MAXREC, so no ranking is implied).</description>
                <dataType>integer</dataType>
              </param>
              <param std="true">
                <name>COMPRESS</name>
                <description>Return compressed results?</description>
                <dataType>char</dataType>
              </param>
              <param std="true">
                <name>RUNID</name>
                <description>An identifier for a certain run. Opaque to the service</description>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="false">
                <name>TIME</name>
                <description>Time covered by the time series</description>
                <unit>d</unit>
                <ucd>time.epoch</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="false">
                <name>field</name>
                <description>Survey field observed.</description>
                <ucd>meta.id;obs.field</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>RESPONSEFORMAT</name>
                <description>File format requested for output.</description>
                <ucd>meta.code.mime</ucd>
                <dataType arraysize="*">char</dataType>
              </param>
              <param std="true">
                <name>MAXREC</name>
                <description>Maximum number of records returned. Pass 0 to retrieve service parameters.</description>
                <dataType>integer</dataType>
              </param>
              <param std="true">
                <name>VERB</name>
                <description>Exhaustiveness of column selection. VERB=1 only returns the most important columns, VERB=2 selects the columns deemed useful to the average user, VERB=3 returns a table with all available columns.</description>
                <dataType>integer</dataType>
              </param>
            </interface>
            <complianceLevel>query</complianceLevel>
            <productType>timeseries</productType>
            <dataSource>survey</dataSource>
            <creationType>archival</creationType>
            <supportedFrame>ICRS</supportedFrame>
            <maxSearchRadius>90</maxSearchRadius>
            <maxRecords>1000000</maxRecords>
            <defaultMaxRecords>10000</defaultMaxRecords>
            <maxAperture>90</maxAperture>
            <testQuery>
              <queryDataCmd>MAXREC=1&amp;REQUEST=queryData</queryDataCmd>
            </testQuery>
          </capability>

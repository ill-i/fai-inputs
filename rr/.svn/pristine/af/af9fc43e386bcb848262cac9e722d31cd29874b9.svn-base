      </creator>
      <date role="creation"> 2010-05-19 </date>
      <date role="updated">  2012-02-17 </date>
      <version> 1.0 </version>
      <contact>
        <name>   Resource Registry Working Group   </name>
	<email>  registry@ivoa.net    </email>
      </contact>

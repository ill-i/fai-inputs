  <title>TNG OIG (IA2 SIA)</title>
  <shortName>TNG-OIG</shortName>
  <identifier>ivo://org.gavo.dc/TNG-OIG-SIAP</identifier>
  <curation>
    <publisher ivo-id="ivo://inaf/INAF">
      
      
